{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/assert-dev-not-prod.mjs",
    "dev": "vite",
    "dev:branch": "node scripts/dev-target-branch.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:deps:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type json > .dependency-cruiser-baseline.json",
    "lint:deps:check": "node scripts/dep-cruise-ratchet.cjs",
    "lint:deps:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg -o dependency-graph.svg",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:ratchet": "node scripts/tsc-ratchet.cjs",
    "typecheck:baseline": "node scripts/tsc-ratchet.cjs --write",
    "guard:master-ghost": "node scripts/definer-master-ghost-ratchet.cjs",
    "guard:master-ghost:write": "node scripts/definer-master-ghost-ratchet.cjs --write",
    "gen:api-spec": "deno run --no-check --unstable-sloppy-imports --allow-read --allow-write scripts/gen-api-spec.ts",
    "gen:feature-catalog": "node scripts/gen-feature-catalog.mjs",
    "gen:feature-catalog:check": "node scripts/gen-feature-catalog.mjs --check",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit/ src/ --reporter=verbose",
    "test:ratchet": "node scripts/test-ratchet.cjs",
    "test:baseline": "node scripts/test-ratchet.cjs --write",
    "test:integration": "vitest run tests/integration/ --reporter=verbose --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run tests/unit/ --coverage",
    "typecheck:edge-shared": "cd supabase/functions && deno task check:shared",
    "test:edge": "cd supabase/functions && deno task test",
    "test:edge:coverage": "cd supabase/functions && rm -rf .coverage && deno task test:coverage && deno task coverage:report",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:secrets": "bash scripts/test-secret-scan.sh",
    "vault:lint": "node scripts/vault-lint.mjs",
    "vault:regen": "node scripts/vault-regen-indexes.mjs",
    "vault:regen:check": "node scripts/vault-regen-indexes.mjs --check",
    "vault:upgrade-fm": "node scripts/vault-upgrade-frontmatter.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist-storybook",
    "typecheck:pending": "node scripts/tsc-ratchet.cjs --write-pending",
    "lint:ratchet": "node scripts/lint-ratchet.cjs",
    "lint:baseline": "node scripts/lint-ratchet.cjs --write",
    "lint:pending": "node scripts/lint-ratchet.cjs --write-pending",
    "test:remote": "vitest run tests/remote/ --reporter=verbose"
  },
