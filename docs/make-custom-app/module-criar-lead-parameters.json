  },
  {
    "name": "meetingDate",
    "type": "date",
    "label": "Data da Reunião",
    "help": "Data/hora da reunião (ISO 8601). Salva em compromisso_date no lead.",
    "required": false
  },
  {
    "name": "assignedUserId",
    "type": "text",
    "label": "Responsável (User ID)",
    "help": "UUID do membro do time para atribuir o lead. Se vazio, usa round robin automático.",
    "required": false
  },
  {
    "name": "notes",
    "type": "text",
    "label": "Notas",
    "help": "Observações sobre o lead",
    "required": false,
    "multiline": true
  },
  {
    "name": "segment",
    "type": "text",
    "label": "Segmento",
    "help": "Segmento de mercado do lead (ex: Indústria, Varejo, Serviços)",
    "required": false
  },
  {
    "name": "faturamento",
    "type": "text",
    "label": "Faturamento",
    "help": "Faixa de faturamento da empresa (ex: 1M-5M, 5M-10M)",
    "required": false
  },
  {
    "name": "urgency",
    "type": "select",
    "label": "Urgência",
    "help": "Nível de urgência do lead",
    "required": false,
    "options": [
      { "label": "Nenhuma", "value": "" },
      { "label": "Baixa", "value": "baixa" },
      { "label": "Média", "value": "media" },
      { "label": "Alta", "value": "alta" },
      { "label": "Urgente", "value": "urgente" }
    ]
  },
  {
    "name": "rating",
    "type": "number",
    "label": "Rating",
    "help": "Nota do lead de 0 a 10",
    "required": false,
    "validate": {
      "min": 0,
      "max": 10
    }
  },
  {
    "name": "updateExisting",
    "type": "boolean",
    "label": "Atualizar se já existir?",
    "help": "Se ativado, atualiza lead existente com mesmo telefone/email ao invés de criar duplicata.",
    "required": false,
    "default": false
  },
  {
    "name": "customFields",
    "type": "array",
    "label": "Campos Personalizados",
    "help": "Adicione quantos campos extras precisar. Cada campo vira um campo personalizado no lead. Clique '+ Add item' para cada campo.",
    "required": false,
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Nome do Campo",
        "help": "Nome do campo personalizado (ex: cidade, cargo, cnpj, num_funcionarios)",
        "required": true
      },
      {
        "name": "value",
        "type": "text",
        "label": "Valor",
        "help": "Valor do campo. Pode mapear de módulos anteriores do cenário.",
        "required": true
      }
    ]
  },
  {
    "name": "utmSource",
    "type": "text",
    "label": "UTM Source",
    "help": "Parâmetro utm_source (opcional, para tracking)",
