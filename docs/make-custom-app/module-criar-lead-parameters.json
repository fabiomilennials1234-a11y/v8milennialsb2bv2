    "required": false,
    "advanced": true
  },
  {
    "name": "utmContent",
    "type": "text",
    "label": "UTM Content",
    "help": "Parâmetro utm_content (opcional, para tracking)",
    "required": false,
    "advanced": true
  },
  {
    "name": "utmTerm",
    "type": "text",
    "label": "UTM Term",
    "help": "Parâmetro utm_term (opcional, para tracking)",
    "required": false,
    "advanced": true
  }
