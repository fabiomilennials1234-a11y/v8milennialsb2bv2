      { "label": "── WhatsApp ──", "value": "", "nested": true },
      { "label": "Novo Lead", "value": "novo" },
      { "label": "Abordado", "value": "abordado" },
      { "label": "Respondeu", "value": "respondeu" },
      { "label": "Esfriou", "value": "esfriou" },
      { "label": "Agendado", "value": "agendado" },
      { "label": "── Confirmação ──", "value": "", "nested": true },
      { "label": "Reunião Marcada", "value": "reuniao_marcada" },
      { "label": "Confirmar D-3", "value": "confirmar_d3" },
      { "label": "Confirmar D-2", "value": "confirmar_d2" },
      { "label": "Confirmar D-1", "value": "confirmar_d1" },
      { "label": "Pré-confirmada", "value": "pre_confirmada" },
      { "label": "Confirmação no Dia", "value": "confirmacao_no_dia" },
      { "label": "Confirmada no Dia", "value": "confirmada_no_dia" },
      { "label": "Compareceu", "value": "compareceu" },
      { "label": "── Propostas ──", "value": "", "nested": true },
      { "label": "Marcar Compromisso", "value": "marcar_compromisso" },
      { "label": "Compromisso Marcado", "value": "compromisso_marcado" },
      { "label": "Esfriou (Propostas)", "value": "esfriou" },
      { "label": "Futuro", "value": "futuro" },
      { "label": "Vendido", "value": "vendido" },
      { "label": "Perdido", "value": "perdido" }
