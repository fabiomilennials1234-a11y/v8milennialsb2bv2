[
  {
    "name": "name",
    "type": "text",
    "label": "Nome",
    "help": "Nome completo do lead",
    "required": false
  },
  {
    "name": "phone",
    "type": "text",
    "label": "Telefone",
    "help": "Telefone com DDD e código do país (ex: 5511999999999). Obrigatório se email não for preenchido.",
    "required": false
  },
  {
    "name": "email",
    "type": "text",
    "label": "Email",
    "help": "Email do lead. Obrigatório se telefone não for preenchido.",
    "required": false
  },
  {
    "name": "company",
    "type": "text",
    "label": "Empresa",
    "help": "Nome da empresa do lead",
    "required": false
  },
  {
    "name": "source",
    "type": "select",
    "label": "Origem",
    "help": "De onde o lead veio",
    "required": false,
    "default": "make",
    "options": [
      { "label": "Make.com", "value": "make" },
      { "label": "Meta Ads (Facebook/Instagram)", "value": "meta_ads" },
      { "label": "Google Ads", "value": "google_ads" },
      { "label": "Site / Landing Page", "value": "site" },
      { "label": "Indicação", "value": "indicacao" },
      { "label": "WhatsApp", "value": "whatsapp" },
      { "label": "Calendly", "value": "calendly" },
      { "label": "LinkedIn", "value": "linkedin" },
      { "label": "Evento", "value": "evento" },
      { "label": "Outro", "value": "outro" }
    ]
  },
  {
    "name": "tags",
    "type": "text",
    "label": "Tags",
    "help": "Tags separadas por vírgula (ex: Ouro, Meta Ads, Q1). Máximo 50 tags.",
    "required": false
  },
  {
    "name": "pipe",
    "type": "select",
    "label": "Pipeline",
    "help": "Em qual pipeline colocar o lead (opcional)",
    "required": false,
    "options": [
      { "label": "Nenhum", "value": "" },
      { "label": "WhatsApp (Qualificação)", "value": "whatsapp" },
      { "label": "Confirmação (Reunião)", "value": "confirmacao" },
      { "label": "Propostas (Fechamento)", "value": "propostas" }
    ]
  },
  {
    "name": "stage",
    "type": "select",
    "label": "Estágio",
    "help": "Estágio dentro do pipeline selecionado",
    "required": false,
    "options": [
