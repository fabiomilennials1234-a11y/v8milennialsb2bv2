{
  "url": "{{common.supabaseUrl}}/functions/v1/lead-webhook",
  "method": "POST",
  "headers": {
    "Authorization": "Bearer {{common.anonKey}}",
    "x-webhook-key": "{{common.webhookApiKey}}",
    "Content-Type": "application/json"
  },
  "body": {
    "source": "{{parameters.source}}",
    "organization_id": "{{connection.organizationId}}",
    "fields": {
      "name": "{{parameters.name}}",
      "phone": "{{parameters.phone}}",
      "email": "{{parameters.email}}",
      "company": "{{parameters.company}}",
      "notes": "{{parameters.notes}}",
      "segment": "{{parameters.segment}}",
      "faturamento": "{{parameters.faturamento}}",
      "urgency": "{{parameters.urgency}}",
      "rating": "{{parameters.rating}}",
      "utm_source": "{{parameters.utmSource}}",
      "utm_medium": "{{parameters.utmMedium}}",
      "utm_campaign": "{{parameters.utmCampaign}}",
      "utm_content": "{{parameters.utmContent}}",
      "utm_term": "{{parameters.utmTerm}}"
    },
    "custom_fields": "{{toCollection(parameters.customFields; 'key'; 'value')}}",
    "tags": "{{parameters.tags}}",
    "update_existing_if_match": "{{parameters.updateExisting}}",
    "assigned_user_id": "{{parameters.assignedUserId}}",
    "place_in_pipe": {
      "pipe": "{{parameters.pipe}}",
      "stage": "{{parameters.stage}}",
      "meeting_date": "{{parameters.meetingDate}}"
    }
  },
  "response": {
    "output": "{{body}}"
  }
}
