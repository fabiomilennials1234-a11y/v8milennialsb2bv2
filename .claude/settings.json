{
  "enabledPlugins": {
    "obsidian@obsidian-skills": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/orchestrador-router-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/obsidian-post-commit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(supabase functions deploy:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(supabase functions list:*)",
      "Bash(npx supabase functions list:*)"
    ]
  }
}
