# Playwright E2E environment variables
#
# Copy to .env.e2e and fill in real values before running `npm run test:e2e`.

# Required by 11-meta-chat-flow.spec.ts
E2E_ORG_ID=                 # uuid of the test org with a connected Meta page
E2E_META_PAGE_ID=           # page_id (string, not uuid) of an active meta_pages row in E2E_ORG_ID
E2E_USER_EMAIL=             # email of a team_member in E2E_ORG_ID
E2E_USER_PASSWORD=          # password of E2E_USER_EMAIL
