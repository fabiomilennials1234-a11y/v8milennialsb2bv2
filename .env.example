# ==============================================
# ARQUIVO DE EXEMPLO - CONFIGURAÇÕES DO AMBIENTE
# ==============================================
# NUNCA commite arquivos .env com credenciais reais!
# Todos os .env* (exceto .env.example e .env.local.example) estão no .gitignore.
#
# ── ESTRUTURA DE AMBIENTES (Vite) ────────────────────────────
#
# Arquivo              │ Quando carrega           │ Uso
# ─────────────────────┼──────────────────────────┼──────────────────────────
# .env                 │ Sempre                   │ Produção (npm run build)
# .env.development     │ npm run dev              │ Dev remoto (Supabase cloud)
# .env.local           │ Sempre (maior prioridade)│ Supabase local (Docker)
# .env.local.example   │ Nunca (é template)       │ Template para .env.local
#
# ── PRIORIDADE ───────────────────────────────────────────────
# npm run dev  → .env.local > .env.development > .env
# npm run build → .env.local > .env.production > .env
#
# ── WORKFLOW ─────────────────────────────────────────────────
# Dev remoto:   npm run dev  (usa .env.development)
# Dev local:    cp .env.local.example .env.local → supabase start → npm run dev
# Build prod:   npm run build (usa .env)
# ==============================================

# Supabase Configuration
# Obtenha em: https://supabase.com/dashboard/project/SEU_PROJECT/settings/api
VITE_SUPABASE_PROJECT_ID="seu_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_anon_key"
VITE_SUPABASE_URL="https://seu_project_id.supabase.co"

# Connection string do Postgres (opcional, só para rodar migrations pelo terminal)
# Obtenha em: Supabase Dashboard > Settings > Database > Connection string > URI
# DATABASE_URL="postgresql://..."

# ==============================================
# Convite por email (escolha UMA das opções)
# ==============================================
# Opção A (recomendado): Backend que valida admin e chama a Edge Function.
# URL do seu backend (ex: Vercel/Netlify function). O backend usa INTERNAL_API_KEY.
# VITE_INVITE_API_URL="https://seu-dominio.com/api/invite-user"
#
# Opção B: REMOVIDA — VITE_INTERNAL_API_KEY expunha secret no client bundle.
# Use apenas Opção A (backend proxy) ou service_role em Edge Functions.

# ==============================================
# IMPORTANTE - SEGURANÇA
# ==============================================
# - A VITE_SUPABASE_PUBLISHABLE_KEY é pública por design (pode ser exposta no frontend)
# - NUNCA use a service_role key no frontend
# - Configure RLS (Row Level Security) no Supabase para proteger seus dados
# ==============================================

# Ambiente (development ou production)
NODE_ENV="development"

# Desabilitar logs em produção (opcional)
VITE_DISABLE_CONSOLE_LOGS="false"

# ==============================================
# Google Calendar Service
# ==============================================
# Em desenvolvimento: http://localhost:8000
# Em produção: URL do seu serviço deployado
VITE_CALENDAR_SERVICE_URL="http://localhost:8000"

# ==============================================
# Deploy VPS Hostinger (API / Fluxo A) - directives/deploy_hostinger_vps.md
# ==============================================
# Token em hPanel → Perfil → API (mesmo do .mcp.json para hostinger-mcp)
# HOSTINGER_API_TOKEN="seu_token_aqui"
# HOSTINGER_VPS_ID=12345
# GITHUB_REPO_URL="https://github.com/USUARIO/REPO"
# HOSTINGER_PROJECT_NAME="v8milennialsb2b"

# ==============================================
# Deploy VPS (Fluxo B - rsync) - directives/deploy_hostinger_vps.md
# ==============================================
# VPS_HOST=ip.ou.hostname.da.vps
# VPS_USER=root
# VPS_PATH=/var/www/html
# VPS_SSH_KEY=/caminho/para/chave_privada  # opcional

# ==============================================
# Meta Ads Insights (UTMs Analytics Tab)
# ==============================================
# Token de longa duração do Facebook Developer (permissões: ads_read)
# META_ADS_ACCESS_TOKEN="EAAxxxxxxx"
# ID da conta de anúncios (prefixo "act_")
# META_ADS_ACCOUNT_ID="act_1234567890"
# UUID da organização Milennials (para gating da tab e webhook enrichment)
# MILENNIALS_ORG_ID="uuid-da-org"
# Frontend: usado para mostrar/esconder a tab UTMs
VITE_MILENNIALS_ORG_ID=""

# ==============================================
# Feature Flags (build-time)
# ==============================================
# chatOnda2b — ativa o ChatShell 3-col resizable em /chat.
# false (padrão) → WhatsAppChat legacy (comportamento atual)
# true           → ChatShellWithContext (Onda 2b)
VITE_CHAT_ONDA_2B=false

# ==============================================
# Sentry (Error tracking)
# ==============================================
# DSN público — seguro expor no frontend (identifica seu projeto, não autentica)
# Obtenha em: sentry.io > Settings > Projects > <project> > Client Keys (DSN)
VITE_SENTRY_DSN="https://xxx@oyyy.ingest.sentry.io/zzz"
#
# Variáveis de build (usadas pelo @sentry/vite-plugin para upload de source maps)
# Configurar como secrets do CI, NÃO no arquivo .env
# SENTRY_ORG="nome-da-sua-org"
# SENTRY_PROJECT="v8milennialsb2b"
# SENTRY_AUTH_TOKEN="seu_auth_token_aqui"

# ==============================================
# Meta Ads (WhatsApp Business / Meta App)
# ==============================================
VITE_META_APP_ID="seu_meta_app_id"

# ==============================================
# Uazapi (WhatsApp provider) — Supabase secrets only
# Nunca commitar valores. Configurar via:
#   supabase secrets set UAZAPI_* --project-ref <ref>
# ==============================================
# UAZAPI_BASE_URL=https://free.uazapi.com
# UAZAPI_ADMIN_TOKEN=
# UAZAPI_WEBHOOK_SECRET=
