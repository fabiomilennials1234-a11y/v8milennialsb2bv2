# MCP config (contains API keys)
.mcp.json

# IDE and agent configs
.agent/
.agents/
.windsurf/
.superpowers/

# =============================================================================
# Obsidian — sujeira local fora, conteúdo do vault dentro
# =============================================================================
# Toda a pasta .obsidian/ contém estado local (workspace, graph layout, plugins
# resolvidos, cache). Manter ignorada por padrão — share de plugin config é
# decisão deliberada em PR separado.
.obsidian/
Obsidian/**/.obsidian/

# Lixeira e cache de plugins
Obsidian/**/.trash/
Obsidian/**/.smart-env/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build cache (typecheck usa --noEmit; cache nunca commitado)
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development

# Editor directories and files
.vscode/*
.cursor/
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files for agent orchestration
.tmp/

# Supabase local files (contain sensitive data)
supabase/.temp/
supabase/.branches/

# SQL files with credentials or admin operations (should not be committed)
*.credentials.sql
CRIAR_ORGANIZACAO*.sql
VINCULAR_ORGANIZACAO.sql
FORCAR_VINCULO_ORGANIZACAO.sql
SOLUCAO_DEFINITIVA_RLS.sql
scripts/insert-master-user.sql
*.pem
*.key
*.p8

# Test artifacts
.playwright-auth/
test-results/
playwright-report/
coverage/

# Deno edge-function coverage artifacts
supabase/functions/.coverage/
supabase/functions/coverage.lcov

# Storybook build output
dist-storybook/
storybook-static/

# Python virtual environments (services/)
services/**/venv/
services/**/.venv/
**/__pycache__/
*.pyc

# Playwright MCP screenshots/logs (local, ephemeral)
.playwright-mcp/
.claude/worktrees/
scripts/basic4u-clients.json

# Scripts one-off de ops/incidentes — arquivar fora do repo (Desktop/torque-ops-archive-*)
scripts/recovery/

# Scratch/debug dumps na raiz (query outputs, briefings descartáveis).
# Ancorado em / pra NÃO pegar arquivos _foo.py legítimos em subpastas.
/_*.txt
/_*.json
/_*.gs
/_*.py
/_*.sql
/_*.md

# ESLint cache — ratchet local (scripts/lint-ratchet.cjs). Nunca commitado.
.eslintcache
# Credenciais de ferramenta local. Os padrões `.env*` acima NÃO pegam nomes como
# `.jira.env` — o `.env` fica no fim, não no começo. Verificado em 2026-08-17:
# `git check-ignore .jira.env` saía 1 (não ignorado) enquanto o cabeçalho do
# próprio arquivo afirmava estar ignorado. Token vivo do Jira a um `git add -A`
# de distância de um commit.
.jira.env
*.env

# Dumps do Jira — artefato de leitura, não fonte. Regenera com
# `node scripts/jira-dump.mjs`. Ficam de fora porque são grandes (0,5 MB cada),
# ficam velhos em horas e o diff deles não diz nada a ninguém.
# Os mapas (`jira-status-map.json`, `jira-type-map.json`) SÃO configuração e
# continuam versionados — por isso o padrão é específico, não `jira-*.json`.
.specs/project/jira-dump*.json
.specs/project/jira-abertos*.json
.tmp-jira-dump.json
