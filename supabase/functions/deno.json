{
  "tasks": {
    "test": "deno test --allow-env --allow-net --allow-read --no-check",
    "test:coverage": "deno test --allow-env --allow-net --allow-read --no-check --coverage=.coverage",
    "coverage:report": "deno coverage .coverage --lcov --output=coverage.lcov && deno coverage .coverage"
  },
  "imports": {
    "std/": "https://deno.land/std@0.177.0/",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  }
}
