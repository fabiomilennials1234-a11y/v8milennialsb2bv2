SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: expansão por bairro/sinônimo e filtro de nicho (Claude Haiku 4.5).
ANTHROPIC_API_KEY=
GOSOM_MAX_TIME_S=3600
# Instagram, opção A (sem custo em dólar, com risco de conta): coletor com login real.
# Suba o serviço services/instagram-coletor (ver README dele) e aponte para ele.
INSTAGRAM_COLETOR_URL=
INSTAGRAM_COLETOR_SEGREDO=
# Instagram, opção B (paga): Apify. Só é usada se não houver coletor.
APIFY_TOKEN=
# Teto de gasto NOSSO por busca de Instagram, em dólares. A Apify aborta a execução ao chegar nele.
APIFY_MAX_USD_POR_BUSCA=25
INSTAGRAM_MAX_SEGUIDORES=5000
