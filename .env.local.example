# ==============================================
# SUPABASE LOCAL (Docker) — Template
# ==============================================
# Para testar migrations e funcionalidades localmente:
#
# 1. Copie este arquivo:  cp .env.local.example .env.local
# 2. Suba o Supabase:     supabase start
# 3. Copie os valores que o "supabase start" imprimiu abaixo
# 4. Rode o frontend:     npm run dev
#
# O .env.local tem a MAIOR prioridade no Vite,
# então ele sobrescreve .env e .env.development automaticamente.
#
# Para voltar ao Supabase remoto, basta deletar ou renomear:
#   mv .env.local .env.local.bak
# ==============================================

# Supabase LOCAL — valores impressos por "supabase start"
VITE_SUPABASE_PROJECT_ID="local"
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="COLE_AQUI_A_ANON_KEY_DO_SUPABASE_START"

# Google Calendar Service (local)
VITE_CALENDAR_SERVICE_URL="http://localhost:8000"
