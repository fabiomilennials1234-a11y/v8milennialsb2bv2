                    }
                  ],
                  "created_at": "2026-06-14T14:30:22Z",
                  "updated_at": "2026-06-14T14:30:22Z"
                }
              }
            }
          },
          "4XX": {
            "description": "Erro",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "string",
                    "message": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "api-patch-lead",
        "summary": "Editar lead",
        "description": "Atualização parcial de campos permitidos. Campos não-allowlistados são ignorados. Escopo: lead:write.\n\n422 invalid_tier para tier fora do enum. 422 invalid_responsible se o responsável não pertence à org. 422 no_valid_fields se nenhum campo editável foi enviado.\n\nCampos de negócio como segmento/faturamento/urgência são custom fields — use PUT /custom-fields.",
        "tags": [
          "REST API v1"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do lead (path).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "id": "f21072f1-…",
                  "name": "Acme Renomeado",
                  "tier": "ouro",
                  "rating": 5
                }
              }
            }
          },
          "4XX": {
            "description": "Erro",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "string",
                    "message": "string"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "example": {
                "name": "Acme Renomeado",
                "tier": "ouro",
                "rating": 5
              }
            }
          }
        }
      }
    },
