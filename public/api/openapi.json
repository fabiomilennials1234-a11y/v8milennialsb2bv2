    "/api/v1/leads/{id}/stage": {
      "post": {
        "operationId": "api-move-stage",
        "summary": "Mover etapa",
        "description": "Move o lead para uma etapa de um funil. Dispara as mesmas automações da UI (workflows, meeting_events, auto-Orçamentos ao compareceu). Escopo: lead:write.\n\n400 missing_stage sem stage. 404 se o lead não for da org. 422 stage_move_failed para etapa inválida (a mensagem lista as válidas).\n\nmeeting_date não é suportado no v1.",
        "tags": [
          "REST API v1"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do lead (path).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "moved": true,
                  "target_stage": "compareceu",
                  "target_pipe": "confirmacao"
                }
              }
            }
          },
          "4XX": {
            "description": "Erro",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "string",
                    "message": "string"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "pipe": "confirmacao",
                "stage": "compareceu"
              }
            }
          }
        }
      }
    },
