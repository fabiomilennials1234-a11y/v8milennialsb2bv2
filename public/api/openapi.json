  },
  "servers": [
    {
      "url": "https://jsjsmuncfkbsbzqzqhfq.supabase.co/functions/v1",
      "description": "Produção"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
