  "paths": {
    "/api/v1/ping": {
      "get": {
        "operationId": "api-ping",
        "summary": "Ping",
        "description": "Smoke check autenticado. Confirma que a API Key é válida e retorna a organização vinculada. Não exige escopo específico.",
        "tags": [
          "REST API v1"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "pong": true,
                  "organization_id": "6030520a-2ca7-477d-be89-55758e2cd808",
                  "timestamp": "2026-06-14T19:05:04.767Z"
                }
              }
            }
          },
          "4XX": {
            "description": "Erro",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "string",
                    "message": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/leads": {
      "get": {
        "operationId": "api-list-leads",
        "summary": "Listar leads",
        "description": "Lista leads com paginação keyset (cursor) e filtros flat. Cada item traz tier efetivo, tags, responsáveis e se foi vendido (+ valor). Escopo: lead:read.\n\nListas retornam { data, next_cursor, has_more }. Pagine passando next_cursor de volta em ?cursor=. Erros: { error: { code, message, details? } }.\n\nOrdenação fixa: created_at desc, id desc.",
        "tags": [
          "REST API v1"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "stage",
            "in": "query",
            "required": false,
            "description": "Etapas (csv). Lead com entry em qualquer pipe nessas etapas. Ex: \"novo,abordado\".",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tier",
            "in": "query",
            "required": false,
            "description": "Tier efetivo (csv): diamante, ouro, prata, bronze, desqualificado.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Nomes de tag (csv, case-insensitive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "description": "Origem (csv).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "responsible_id",
            "in": "query",
            "required": false,
            "description": "Casa responsible/sdr/closer/pré-vendas/vendas.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_from",
            "in": "query",
            "required": false,
            "description": "created_at >= (ISO 8601).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_to",
            "in": "query",
            "required": false,
            "description": "created_at <= (ISO 8601).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Busca em nome, empresa, email, telefone.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "1–100. Default 50.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "next_cursor da página anterior (opaco).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "id": "f21072f1-…",
                      "name": "Nairde",
                      "company": "Valim",
                      "origin": "outro",
                      "tier": "ouro",
                      "tags": [
                        {
                          "id": "t1",
                          "name": "VIP",
                          "color": "#F5C518"
                        }
                      ],
                      "responsible_id": "bf98…",
                      "sdr_id": null,
                      "closer_id": null,
                      "sold": false,
                      "sale_value": null,
                      "rating": 4,
                      "qualification_score": 80,
                      "created_at": "2026-06-14T14:30:22Z"
                    }
                  ],
                  "next_cursor": "eyJjIjoi…",
                  "has_more": true
                }
              }
            }
          },
          "4XX": {
            "description": "Erro",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "string",
                    "message": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/leads/{id}": {
      "get": {
        "operationId": "api-get-lead",
        "summary": "Lead 360",
        "description": "Retorna um lead completo: tier, tags, custom fields (valores), responsáveis e posições em todos os pipes (com vendido/valor). 404 se não existir na org. Escopo: lead:read.",
